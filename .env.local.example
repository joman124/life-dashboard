# ─────────────────────────────────────────────────────────────────────────────
# Life Dashboard — environment variables
#
# Copy this file to `.env.local` (which is gitignored) and fill in the values.
# Only the three GOOGLE_* vars are required to enable the Google connector;
# the rest are optional. Restart `npm run dev` after editing this file —
# Next.js only reads .env.local at server startup.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google OAuth (Calendar + Gmail) ─────────────────────────────────────────
# Create these in Google Cloud Console (see README for the step-by-step):
#   1. console.cloud.google.com → new project "life-dashboard"
#   2. Enable the Google Calendar API and the Gmail API
#   3. Configure the OAuth consent screen (External, add yourself as a test user)
#   4. Credentials → Create OAuth client ID → Web application
#   5. Add the redirect URI below to the client's "Authorized redirect URIs"
#
# Without all three of these set, the Google connector reports
# status "not_configured" and every Google route fails cleanly (never silently).

# OAuth 2.0 client ID, e.g. 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# OAuth 2.0 client secret, e.g. GOCSPX-xxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=

# Must EXACTLY match an Authorized redirect URI on the OAuth client in Google
# Cloud Console. Default for local dev (leave as-is unless you change the port):
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Token encryption at rest (optional) ──────────────────────────────────────
# If set, the stored Google OAuth tokens (access + refresh) are encrypted with
# AES-256-GCM before being written to the SQLite database. If unset, tokens are
# stored as plaintext in data/life-dashboard.db — acceptable for a single local
# user because data/ is gitignored, but encrypting is recommended.
#
# Must be 32 bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ── Database (libSQL / Turso) ────────────────────────────────────────────────
# The app talks to its database through @libsql/client, which drives BOTH a local
# SQLite file (dev) and a remote Turso database (production) with one API.
#
# When BOTH of the variables below are UNSET, the app falls back to a local file
# at data/life-dashboard.db (created + seeded on first run; data/ is gitignored).
# This is the default for local development — leave them blank and it just works.
#
# Set BOTH to point at a remote Turso database instead. This is required on
# Vercel (and any serverless host) because the filesystem there is read-only, so
# a local file DB cannot persist. Create a database and token with the Turso CLI:
#   turso db create life-dashboard
#   turso db show life-dashboard --url        # → TURSO_DATABASE_URL
#   turso db tokens create life-dashboard      # → TURSO_AUTH_TOKEN
#
# libSQL connection URL, e.g. libsql://your-db-name.turso.io
TURSO_DATABASE_URL=

# Auth token for the Turso database above (a long JWT). Keep it secret.
TURSO_AUTH_TOKEN=

# ── Display (optional) ───────────────────────────────────────────────────────
# Your first name, used in the Today tab greeting ("Good morning, <name>").
# Exposed to the browser (NEXT_PUBLIC_ prefix); never put secrets here.
NEXT_PUBLIC_USER_NAME=
